---
import { getImage, Picture } from 'astro:assets';
import { render } from 'astro:content';
import ArtworkCard from '../../components/ArtworkCard.astro';
import Brush from '../../components/Brush.astro';
import Icon from '../../components/Icon.astro';
import Layout from '../../layouts/Layout.astro';
import {
  type Artwork,
  artworkCta,
  categoryLabels,
  getPublishedArtworks,
  mainImage,
  statusLabels,
} from '../../lib/artworks';
import { artworkJsonLd, graph } from '../../lib/seo';

export const getStaticPaths = async () => {
  const artworks = await getPublishedArtworks();
  return artworks.map((artwork) => ({ params: { slug: artwork.id }, props: { artwork, artworks } }));
};

interface Props {
  artwork: Artwork;
  artworks: Artwork[];
}

const { artwork, artworks } = Astro.props;
const { title, category, status, year, technique, dimensions } = artwork.data;
const { Content } = await render(artwork);
const hasDescription = Boolean(artwork.body?.trim());

const main = mainImage(artwork);
const gallery = artwork.data.images.filter((image) => image !== main && image.kind !== 'certificate');
const hasCertificate = artwork.data.images.some((image) => image.kind === 'certificate');
const cta = artworkCta(artwork);
const related = artworks.filter((other) => other.data.category === category && other.id !== artwork.id).slice(0, 3);
const ogImage = await getImage({ src: main.src, width: 1200, format: 'jpeg' });
const origin = Astro.site ?? Astro.url;
const jsonLd = graph(artworkJsonLd(artwork, origin, new URL(ogImage.src, origin).href));
const facts = [technique, year?.toString()].filter(Boolean).join(', ');
const description = `${title}${facts ? ` (${facts})` : ''}, obra de Stephany Londoño, artista plástica colombiana. ${categoryLabels[category]}.`;

const details = [
  { label: 'Categoría', value: categoryLabels[category] },
  { label: 'Estado', value: status ? statusLabels[status] : undefined },
  { label: 'Año', value: year?.toString() },
  { label: 'Técnica', value: technique },
  { label: 'Medidas', value: dimensions ? `${dimensions.width} × ${dimensions.height} ${dimensions.unit}` : undefined },
].filter((detail): detail is { label: string; value: string } => detail.value !== undefined);
---

<Layout title={title} description={description} image={ogImage.src} imageAlt={main.alt} type="article" jsonLd={jsonLd}>
  <article class="mx-auto flex max-w-6xl flex-col gap-16 px-4 pt-32 md:px-8">
    <a href="/obras" class="inline-flex w-max items-center gap-2 text-sm text-ink-soft transition-colors duration-700 ease-fluid hover:text-ink">
      <Icon name="arrow-left" class="size-4" />
      Todas las obras
    </a>

    <div class="grid gap-12 lg:grid-cols-[3fr_2fr] lg:items-start">
      <figure class="relative flex items-center justify-center rounded-lg border border-line bg-surface p-3" style={`view-transition-name: obra-${artwork.id}`}>
        <Picture
          src={main.src}
          alt={main.alt}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          widths={[640, 960, 1440, 1920]}
          sizes="(min-width: 1152px) 640px, (min-width: 1024px) 56vw, 100vw"
          loading="eager"
          fetchpriority="high"
          class="max-h-[80vh] w-full object-contain"
        />
        {
          (status === 'sold' || status === 'available') && (
            <p class="absolute top-6 left-6 flex items-center gap-2 rounded-full bg-surface/90 px-3 py-1.5 text-sm font-semibold text-ink shadow-sm backdrop-blur-sm">
              <span class="relative flex size-2.5" aria-hidden="true">
                {status === 'available' && (
                  <span class="absolute inset-0 rounded-full bg-available opacity-75 motion-safe:animate-ping" />
                )}
                <span class:list={['relative size-2.5 rounded-full', status === 'sold' ? 'bg-sold' : 'bg-available']} />
              </span>
              {statusLabels[status]}
            </p>
          )
        }
      </figure>

      <div class="flex flex-col gap-8 lg:sticky lg:top-32">
        <header class="flex flex-col gap-2">
          <p class="text-sm text-ink-soft">{categoryLabels[category]}</p>
          <h1 class="text-5xl md:text-6xl">{title}</h1>
          <Brush variant="flat" class="brush--load -ml-2 w-64 text-sand md:w-80" />
        </header>

        <dl class="grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 border-y border-line py-6 text-sm">
          {
            details.map((detail) => (
              <>
                <dt class="text-ink-soft">{detail.label}</dt>
                <dd class="text-ink">{detail.value}</dd>
              </>
            ))
          }
        </dl>

        {
          hasCertificate && (
            <p class="flex items-center gap-2 text-sm text-ink">
              <Icon name="certificate" class="size-5 text-moss-deep" />
              Incluye certificado de autenticidad
            </p>
          )
        }

        {
          hasDescription && (
            <div class="flex flex-col gap-4 text-base text-ink-soft">
              <Content />
            </div>
          )
        }

        <a
          href={cta.href}
          target="_blank"
          rel="noopener"
          class="inline-flex w-max items-center gap-2 rounded-full bg-ink px-3 py-2 text-base font-semibold text-bg transition-transform duration-700 ease-fluid hover:-translate-y-0.5 active:translate-y-px"
        >
          <Icon name="whatsapp" />
          {cta.label}
        </a>
      </div>
    </div>

    {
      gallery.length > 0 && (
        <section aria-labelledby="detalles" class="flex flex-col gap-6">
          <h2 id="detalles" class="text-3xl">Detalles y proceso</h2>
          <div class="grid items-start gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {gallery.map((image) => (
              <figure class="rounded-lg border border-line bg-surface p-3">
                <Picture
                  src={image.src}
                  alt={image.alt}
                  formats={['avif', 'webp']}
                  fallbackFormat="webp"
                  widths={[400, 640, 960]}
                  sizes="(min-width: 1152px) 352px, (min-width: 1024px) 30vw, (min-width: 640px) 45vw, 90vw"
                  class="w-full"
                />
                <figcaption class="pt-3 text-sm text-ink-soft">{image.alt}</figcaption>
              </figure>
            ))}
          </div>
        </section>
      )
    }

    {
      related.length > 0 && (
        <section aria-labelledby="relacionadas" class="flex flex-col gap-6">
          <div class="flex items-end justify-between gap-4">
            <h2 id="relacionadas" class="text-3xl">Más {categoryLabels[category].toLowerCase()}</h2>
            <a href={`/obras?cat=${category}`} class="inline-flex items-center gap-2 text-sm text-ink-soft hover:text-ink">
              Ver todas
              <Icon name="arrow-right" class="size-4" />
            </a>
          </div>
          <div class="grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((other, index) => <ArtworkCard artwork={other} delay={(index % 3) * 120} />)}
          </div>
        </section>
      )
    }
  </article>
</Layout>
