---
import { Picture } from 'astro:assets';
import artistPhoto from '../assets/artist/stephany-at-biarco.webp';
import ArtworkCard from '../components/ArtworkCard.astro';
import Icon from '../components/Icon.astro';
import ScrollWorld from '../components/ScrollWorld.astro';
import { site, whatsappUrl } from '../data/site';
import Layout from '../layouts/Layout.astro';
import { categoryNames, getPublishedArtworks, mainImage, statusLabels } from '../lib/artworks';
import { artistJsonLd, graph, websiteJsonLd } from '../lib/seo';

const published = await getPublishedArtworks();
const [hero, ...rest] = published.filter((artwork) => artwork.data.featured);
const more = rest.slice(0, 6);
const heroImage = mainImage(hero);
const heroExhibition = site.exhibitions.findLast((exhibition) => exhibition.artwork === hero.data.title);
const heroCaption = [
  categoryNames[hero.data.category],
  heroExhibition
    ? `${heroExhibition.event} ${heroExhibition.year}`
    : hero.data.status && statusLabels[hero.data.status],
]
  .filter(Boolean)
  .join(' · ');
const origin = Astro.site ?? Astro.url;
const jsonLd = graph(websiteJsonLd(origin), artistJsonLd(origin));
---

<Layout jsonLd={jsonLd}>
  <ScrollWorld />

  <div class="after-world">
    <section aria-labelledby="obra-insignia" class="grid md:grid-cols-[1.15fr_1fr]">
      <a
        href={`/obras/${hero.id}`}
        class="group flex flex-col items-center justify-center gap-5 bg-ink px-4 py-16 md:px-10 md:py-20"
      >
        <div style={`view-transition-name: obra-${hero.id}`}>
          <Picture
            src={heroImage.src}
            alt={heroImage.alt}
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            widths={[480, 720, 960, 1280]}
            sizes="(min-width: 768px) 50vw, 90vw"
            class="canvas max-h-[78vh] w-auto transition-transform duration-700 ease-fluid group-hover:-translate-y-1"
          />
        </div>
        <div class="flex w-full max-w-xl flex-col gap-0.5">
          <h2 id="obra-insignia" class="text-3xl text-bg italic">{hero.data.title}</h2>
          <p class="text-sm text-ink-faint">{heroCaption}</p>
        </div>
      </a>

      <div class="flex flex-col justify-center gap-8 bg-bg px-4 py-16 md:px-12 md:py-20">
        <p class="text-xs font-semibold tracking-[0.16em] text-moss-deep uppercase">
          {site.artistName} · {site.role}
        </p>
        <blockquote class="max-w-xl">
          <p class="font-display text-3xl text-ink italic md:text-4xl">“{site.quote}”</p>
        </blockquote>
        <ul class="flex flex-wrap gap-2">
          {
            site.highlights.map((highlight) => (
              <li class="flex flex-col rounded-full border border-line bg-surface px-4 py-1.5 text-xs leading-snug">
                <span class="font-semibold text-ink">{highlight.title}</span>
                <span class="text-ink-soft">{highlight.detail}</span>
              </li>
            ))
          }
        </ul>
        <div class="flex flex-wrap gap-3">
          <a
            href={whatsappUrl(site.whatsapp.commissionMessage)}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 rounded-full bg-ink px-3 py-2 text-base font-semibold text-bg transition-transform duration-700 ease-fluid hover:-translate-y-0.5 active:translate-y-px"
          >
            <Icon name="whatsapp" />
            Encargar una obra
          </a>
          <a
            href="/obras"
            class="inline-flex items-center rounded-full border-[1.5px] border-ink/25 px-3 py-2 text-base font-semibold text-ink transition-transform duration-700 ease-fluid hover:-translate-y-0.5 active:translate-y-px"
          >
            Ver las obras
          </a>
        </div>
      </div>
    </section>

    <section id="sobre" aria-labelledby="sobre-titulo" class="grid border-t border-line md:grid-cols-[1fr_1.6fr]">
      <div class="flex flex-col gap-6 bg-surface px-4 py-16 md:px-10 md:py-20">
        <div class="max-w-sm">
          <Picture
            src={artistPhoto}
            alt="Stephany Londoño con el catálogo de la Bienal de Armenia"
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            widths={[320, 480, 640]}
            sizes="(min-width: 768px) 24rem, 90vw"
            class="aspect-4/5 w-full object-cover"
          />
        </div>
        <h2 id="sobre-titulo" class="text-4xl">Sobre mí</h2>
        <p class="text-base text-ink-soft">{site.intro}</p>
        <details class="group">
          <summary class="inline-flex cursor-pointer list-none items-center gap-2 border-b border-line pb-0.5 text-sm font-semibold text-ink">
            <span class="group-open:hidden">Leer la biografía</span>
            <span class="hidden group-open:inline">Cerrar la biografía</span>
          </summary>
          <div class="flex flex-col gap-4 pt-6">
            {site.bio.map((paragraph) => <p class="text-base text-ink-soft">{paragraph}</p>)}
            <ul class="flex flex-col gap-2 border-t border-line pt-4 text-sm">
              {
                site.exhibitions.map((exhibition) => (
                  <li class="grid grid-cols-[3.5rem_1fr] gap-3">
                    <span class="text-moss-deep">{exhibition.year}</span>
                    <span>
                      <span class="font-display text-lg text-ink italic">{exhibition.artwork}</span>
                      <span class="text-ink-soft"> · {exhibition.event}</span>
                    </span>
                  </li>
                ))
              }
            </ul>
          </div>
        </details>
      </div>

      <div class="flex flex-col gap-10 bg-bg px-4 py-16 md:px-10 md:py-20">
        <div class="flex items-end justify-between gap-4">
          <h2 class="text-4xl">Más obras</h2>
          <a href="/obras" class="inline-flex items-center gap-2 text-sm text-ink-soft hover:text-ink">
            Ver las {published.length} obras
            <Icon name="arrow-right" class="size-4" />
          </a>
        </div>
        <div class="grid grid-cols-2 items-end gap-x-6 gap-y-12 lg:grid-cols-3">
          {
            more.map((artwork) => (
              <ArtworkCard artwork={artwork} sizes="(min-width: 1024px) 18vw, (min-width: 768px) 28vw, 45vw" />
            ))
          }
        </div>
      </div>
    </section>

    <section aria-labelledby="encargo-titulo" class="bg-moss text-bg">
      <div class="mx-auto flex max-w-6xl flex-col gap-12 px-4 py-24 md:px-8">
        <div class="flex max-w-2xl flex-col gap-4">
          <h2 id="encargo-titulo" class="text-4xl md:text-5xl">Cómo funciona un encargo</h2>
          <p class="text-lg text-bg">Una obra hecha a mano a partir de tu historia, en tres pasos.</p>
        </div>
        <ol class="grid gap-6 md:grid-cols-3">
          {
            site.commissionSteps.map((step, index) => (
              <li class="flex flex-col gap-4 rounded-lg border border-ink/10 bg-ink/15 p-6">
                <span class="font-display text-5xl text-bg italic">{index + 1}</span>
                <h3 class="text-2xl">{step.title}</h3>
                <p class="text-base text-bg">{step.text}</p>
              </li>
            ))
          }
        </ol>
        <a
          href={whatsappUrl(site.whatsapp.commissionMessage)}
          target="_blank"
          rel="noopener"
          class="inline-flex w-max items-center gap-2 rounded-full bg-bg px-3 py-2 text-base font-semibold text-ink transition-transform duration-700 ease-fluid hover:-translate-y-0.5 active:translate-y-px"
        >
          <Icon name="whatsapp" />
          Encargar una obra
        </a>
      </div>
    </section>


    {
      site.faq.length > 0 && (
        <section aria-labelledby="faq-titulo" class="bg-bg">
          <div class="mx-auto flex max-w-3xl flex-col gap-8 px-4 py-24 md:px-8">
            <h2 id="faq-titulo" class="text-4xl md:text-5xl">
              Preguntas frecuentes
            </h2>
            <div class="flex flex-col border-t border-line">
              {site.faq.map((item) => (
                <details class="group border-b border-line py-6">
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg text-ink">
                    {item.question}
                    <span class="text-moss-deep transition-transform duration-700 ease-fluid group-open:rotate-45" aria-hidden="true">
                      +
                    </span>
                  </summary>
                  <p class="pt-4 text-base text-ink-soft">{item.answer}</p>
                </details>
              ))}
            </div>
          </div>
        </section>
      )
    }
  </div>
</Layout>
