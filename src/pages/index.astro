---
import { Image, Picture } from 'astro:assets';
import ArtistPortrait from '../components/ArtistPortrait.astro';
import ArtworkCard from '../components/ArtworkCard.astro';
import Brush from '../components/Brush.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import Ridges from '../components/Ridges.astro';
import ScrollWorld from '../components/ScrollWorld.astro';
import ScrollWorldMobile from '../components/ScrollWorldMobile.astro';
import { site, whatsappUrl } from '../data/site';
import { copy, langFromUrl, localePath } from '../i18n';
import Layout from '../layouts/Layout.astro';
import { type Artwork, getPublishedArtworks, mainImage } from '../lib/artworks';
import { artistJsonLd, graph, websiteJsonLd } from '../lib/seo';

const lang = langFromUrl(Astro.url);
const t = copy[lang];
const { categoryNames, statusLabels, ui } = t;
const published = await getPublishedArtworks(lang);
// Newest personal works first: latest year, then gallery order within it. Works still in
// progress have no year and stay out until they are finished.
const recent = published
  .filter((artwork) => artwork.data.category === 'personal' && artwork.data.year)
  .sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0) || a.data.order - b.data.order)
  .slice(0, 3);
const recentIds = new Set(recent.map((artwork) => artwork.id));
const more = published.filter((artwork) => artwork.data.featured && !recentIds.has(artwork.id)).slice(0, 6);
const quoteWords = `“${t.quote}”`.split(' ');
const caption = ({ id, data }: Artwork): string => {
  const exhibition = t.exhibitions.findLast((item) => item.artwork === id);
  return [
    categoryNames[data.category],
    // "Disponible" gets its own green tag next to the caption, so it is left out here.
    exhibition
      ? `${exhibition.event} ${exhibition.year}`
      : data.status && data.status !== 'available'
        ? statusLabels[data.status]
        : data.year,
  ]
    .filter(Boolean)
    .join(' · ');
};
const origin = Astro.site ?? Astro.url;
const jsonLd = graph(websiteJsonLd(origin, lang), artistJsonLd(origin, lang));
---

<Layout jsonLd={jsonLd} hideFooter>
  <ScrollWorld />
  <ScrollWorldMobile />

  <div class="after-world">
    <section aria-labelledby="obras-nuevas" data-spy={localePath(lang, '/obras')} class="grid md:grid-cols-[1.15fr_1fr]">
      <div class="flex min-w-0 flex-col justify-center gap-6 bg-ink py-16 md:py-20">
        <div class="px-4 md:px-10">
          <h2
            id="obras-nuevas"
            data-reveal
            class="mx-auto flex w-full max-w-xl items-center gap-2 font-sans text-xs font-semibold tracking-[0.16em] text-clay uppercase"
          >
            <span class="inline-flex items-center gap-2 rounded-full border border-clay/35 bg-clay/10 px-3 py-1">
              <span class="relative flex size-1.5" aria-hidden="true">
                <span class="absolute inset-0 rounded-full bg-clay opacity-75 motion-safe:animate-ping"></span>
                <span class="relative size-1.5 rounded-full bg-clay"></span>
              </span>
              {ui.newWorks}
            </span>
          </h2>
        </div>

        <ul data-carousel data-reveal class="flex snap-x snap-mandatory overflow-x-auto overscroll-x-contain [scrollbar-width:none]">
          {
            recent.map((artwork, index) => {
              const image = mainImage(artwork);
              const older = recent[index + 1];
              return (
                <li class="flex w-full shrink-0 snap-start flex-col items-center gap-6 px-4 pt-1 pb-4 md:px-10">
                  <a href={localePath(lang, `/obras/${artwork.id}`)} class="group flex w-full flex-col items-center gap-5">
                    <div style={`view-transition-name: obra-${artwork.id}`}>
                      <Picture
                        src={image.src}
                        alt={image.alt}
                        formats={['avif', 'webp']}
                        fallbackFormat="webp"
                        widths={[480, 720, 960, 1280]}
                        sizes="(min-width: 768px) 50vw, 90vw"
                        loading={index === 0 ? 'eager' : 'lazy'}
                        class="canvas max-h-[64vh] w-auto transition-transform duration-700 ease-fluid group-hover:-translate-y-1"
                      />
                    </div>
                    <div class="flex w-full max-w-xl flex-col gap-0.5">
                      <h3 class="text-3xl text-bg italic">{artwork.data.title}</h3>
                      <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-ink-faint">
                        {caption(artwork)}
                        {artwork.data.status === 'available' && (
                          <span class="inline-flex items-center gap-1.5 rounded-full border border-available/50 bg-available/20 px-2 py-0.5 font-semibold text-bg">
                            <span class="relative flex size-1.5" aria-hidden="true">
                              <span class="absolute inset-0 rounded-full bg-available opacity-75 motion-safe:animate-ping" />
                              <span class="relative size-1.5 rounded-full bg-available" />
                            </span>
                            {statusLabels.available}
                          </span>
                        )}
                      </p>
                    </div>
                  </a>

                  <div class="flex w-full max-w-xl items-center justify-between gap-4 border-t border-bg/10 pt-4">
                    {index > 0 ? (
                      <button
                        type="button"
                        data-step="-1"
                        class="hidden items-center gap-2 text-sm font-semibold text-ink-faint transition-colors duration-700 ease-fluid hover:text-bg [.js_&]:inline-flex"
                      >
                        <Icon name="arrow-left" class="size-4" />
                        {ui.newerWork}
                      </button>
                    ) : (
                      <span />
                    )}
                    {older ? (
                      <button
                        type="button"
                        data-step="1"
                        class="group/older hidden items-center gap-3 text-right [.js_&]:inline-flex"
                      >
                        <span class="flex flex-col">
                          <span class="text-xs font-semibold tracking-[0.16em] text-ink-faint uppercase">{ui.olderWork}</span>
                          <span class="font-display text-lg text-bg italic">{older.data.title}</span>
                        </span>
                        <Image
                          src={mainImage(older).src}
                          alt=""
                          widths={[48, 96]}
                          sizes="48px"
                          class="h-15 w-12 rounded-sm object-cover ring-1 ring-bg/15 transition-transform duration-700 ease-fluid group-hover/older:-translate-y-0.5"
                        />
                        <Icon name="arrow-right" class="size-4 text-clay" />
                      </button>
                    ) : (
                      <a
                        href={localePath(lang, '/obras')}
                        class="inline-flex items-center gap-2 text-sm font-semibold text-bg transition-colors duration-700 ease-fluid hover:text-clay"
                      >
                        {ui.viewWorks}
                        <Icon name="arrow-right" class="size-4" />
                      </a>
                    )}
                  </div>
                </li>
              );
            })
          }
        </ul>
      </div>

      <div class="relative flex flex-col justify-center gap-8 overflow-hidden bg-bg px-4 py-16 md:px-12 md:py-20">
        <Ridges
          class="h-[30%]"
          layers={[
            { color: 'var(--color-sand)', opacity: 0.14 },
            { color: 'var(--color-ink-faint)', opacity: 0.16 },
            { color: 'var(--color-ink-faint)', opacity: 0.22 },
            { color: 'var(--color-ink-soft)', opacity: 0.2 },
          ]}
        />
        <p data-reveal class="relative text-xs font-semibold tracking-[0.16em] text-moss-deep uppercase">
          {site.artistName} · {t.role}
        </p>
        <blockquote class="relative max-w-xl">
          <p data-words class="font-display text-3xl text-ink italic md:text-4xl">
            {quoteWords.map((word, index) => <><span data-word style={`--word: ${index}`}>{word}</span>{' '}</>)}
          </p>
        </blockquote>
        <ul data-reveal style="--d: 100ms" class="relative flex flex-wrap gap-2">
          {
            t.highlights.map((highlight) => (
              <li class="flex flex-col rounded-full border border-line bg-surface px-4 py-1.5 text-xs leading-snug">
                <span class="font-semibold text-ink">{highlight.title}</span>
                <span class="text-ink-soft">{highlight.detail}</span>
              </li>
            ))
          }
        </ul>
        <div data-reveal style="--d: 200ms" class="relative flex flex-wrap gap-3">
          <a
            href={whatsappUrl(t.messages.commission)}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 rounded-full bg-ink px-3 py-2 text-base font-semibold text-bg transition-transform duration-700 ease-fluid hover:-translate-y-0.5 active:translate-y-px"
          >
            <Icon name="whatsapp" />
            {ui.commission}
          </a>
          <a
            href={localePath(lang, '/obras')}
            class="inline-flex items-center rounded-full border-[1.5px] border-ink/25 px-3 py-2 text-base font-semibold text-ink transition-transform duration-700 ease-fluid hover:-translate-y-0.5 active:translate-y-px"
          >
            {ui.viewWorks}
          </a>
        </div>
      </div>
    </section>

    <section id="sobre" data-spy={localePath(lang, '/sobre-mi')} aria-labelledby="sobre-titulo" class="grid border-t border-line md:grid-cols-[1fr_1.6fr]">
      <div class="relative flex flex-col gap-6 overflow-hidden bg-surface px-4 pt-16 pb-48 md:px-10 md:pt-20">
        <ArtistPortrait />
        <h2 id="sobre-titulo" data-reveal class="text-4xl">{ui.about}</h2>
        <p data-reveal style="--d: 100ms" class="text-base text-ink-soft">{t.intro}</p>
        <a
          data-reveal
          style="--d: 200ms"
          href={localePath(lang, '/sobre-mi')}
          class="inline-flex w-max items-center gap-2 border-b border-line pb-0.5 text-sm font-semibold text-ink hover:border-ink"
        >
          {ui.readBio}
          <Icon name="arrow-right" class="size-4" />
        </a>
        <Brush class="brush--scroll absolute bottom-0 left-0 w-[min(120%,640px)] -translate-x-[12%] translate-y-[18%] text-sand/60 md:w-[150%] md:translate-y-[8%]" />
      </div>

      <div class="flex flex-col gap-10 bg-bg px-4 py-16 md:px-10 md:py-20">
        <div class="flex items-end justify-between gap-4">
          <h2 data-reveal class="text-4xl">{ui.moreWorks}</h2>
          <a
            href={localePath(lang, '/obras')}
            class="inline-flex shrink-0 items-center gap-2 rounded-full bg-ink px-4 py-2 text-sm font-semibold text-bg transition-transform duration-700 ease-fluid hover:-translate-y-0.5 active:translate-y-px"
          >
            {ui.viewAllWorks(published.length)}
            <Icon name="arrow-right" class="size-4" />
          </a>
        </div>
        <div class="grid grid-cols-2 gap-x-6 gap-y-12 lg:grid-cols-3">
          {
            more.map((artwork, index) => (
              <ArtworkCard artwork={artwork} delay={(index % 3) * 120} sizes="(min-width: 1024px) 18vw, (min-width: 768px) 28vw, 45vw" />
            ))
          }
        </div>
      </div>
    </section>

    <section aria-labelledby="encargo-titulo" class="relative overflow-hidden bg-moss text-bg">
      <Brush class="brush--scroll absolute right-0 bottom-0 w-[min(95vw,720px)] translate-x-[18%] translate-y-[12%] text-bg/40" />
      <div class="relative mx-auto flex max-w-6xl flex-col gap-12 px-4 py-24 md:px-8">
        <div data-reveal class="flex max-w-2xl flex-col gap-4">
          <h2 id="encargo-titulo" class="text-4xl md:text-5xl">{ui.commissionTitle}</h2>
          <p class="text-lg text-bg">{ui.commissionText}</p>
        </div>
        <ol class="grid gap-6 md:grid-cols-3">
          {
            t.commissionSteps.map((step, index) => (
              <li data-reveal style={`--d: ${index * 100}ms`} class="flex flex-col gap-4 rounded-lg border border-ink/10 bg-ink/15 p-6">
                <span class="font-display text-5xl text-bg italic">{index + 1}</span>
                <h3 class="text-2xl">{step.title}</h3>
                <p class="text-base text-bg">{step.text}</p>
              </li>
            ))
          }
        </ol>
        <a
          href={whatsappUrl(t.messages.commission)}
          target="_blank"
          rel="noopener"
          class="inline-flex w-max items-center gap-2 rounded-full bg-bg px-3 py-2 text-base font-semibold text-ink transition-transform duration-700 ease-fluid hover:-translate-y-0.5 active:translate-y-px"
        >
          <Icon name="whatsapp" />
          {ui.commission}
        </a>
      </div>
    </section>


    {
      t.faq.length > 0 && (
        <section aria-labelledby="faq-titulo" class="bg-bg">
          <div class="mx-auto flex max-w-3xl flex-col gap-8 px-4 py-24 md:px-8">
            <h2 id="faq-titulo" class="text-4xl md:text-5xl">
              {ui.faqTitle}
            </h2>
            <div class="flex flex-col border-t border-line">
              {t.faq.map((item) => (
                <details class="group border-b border-line py-6">
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg text-ink">
                    {item.question}
                    <span class="text-moss-deep transition-transform duration-700 ease-fluid group-open:rotate-45" aria-hidden="true">
                      +
                    </span>
                  </summary>
                  <p class="pt-4 text-base text-ink-soft">{item.answer}</p>
                </details>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <Footer />
  </div>

  <script>
    // Stacked sections: a section taller than the viewport must pin once its bottom is
    // in view, not its top, so each one publishes its height for the sticky offset.
    const stack = document.querySelector<HTMLElement>('.after-world');
    if (stack) {
      const observer = new ResizeObserver((entries) => {
        for (const entry of entries) {
          (entry.target as HTMLElement).style.setProperty('--h', `${entry.contentRect.height}px`);
        }
      });
      for (const section of stack.children) observer.observe(section);
    }

    // New works carousel: swipe and trackpad scroll it natively; the buttons step one slide.
    const carousel = document.querySelector<HTMLElement>('[data-carousel]');
    if (carousel) {
      // Lenis smooths the page's vertical wheel and would swallow a mostly sideways trackpad
      // swipe too, so sideways gestures stop here and stay native to the carousel.
      carousel.addEventListener(
        'wheel',
        (event) => {
          if (Math.abs(event.deltaX) > Math.abs(event.deltaY)) event.stopPropagation();
        },
        { passive: true },
      );
      carousel.addEventListener('click', (event) => {
        const button = (event.target as Element).closest<HTMLElement>('[data-step]');
        const slide = button?.closest('li');
        if (!button || !slide) return;
        const step = Number(button.dataset.step);
        const target = step > 0 ? slide.nextElementSibling : slide.previousElementSibling;
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        carousel.scrollBy({ left: step * carousel.clientWidth, behavior: reduceMotion ? 'auto' : 'smooth' });
        // Keyboard users land on the slide they moved to, not on a button that scrolled away.
        target?.querySelector<HTMLElement>('a')?.focus({ preventScroll: true });
      });
    }
  </script>
</Layout>
