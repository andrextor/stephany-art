---
interface Props {
  text: string;
  author: string;
}

const { text, author } = Astro.props;
const words = text.split(' ');
---

<section class="mx-auto max-w-4xl px-4 py-24 md:px-8 md:py-36" aria-label="Cita de la artista">
  <figure class="flex flex-col gap-8 border-l border-moss pl-8">
    <blockquote>
      <p data-tagline class="max-w-[680px] font-display text-4xl text-ink italic md:text-6xl">
        {
          words.map((word) => (
            <>
              <span data-word class="opacity-50 transition-opacity duration-700 ease-fluid data-active:opacity-100">
                {word}
              </span>{' '}
            </>
          ))
        }
      </p>
    </blockquote>
    <figcaption class="text-sm text-ink-soft">{author}</figcaption>
  </figure>
</section>

<script>
  // A word becomes active once it crosses a line at 60% of the viewport height and
  // stays active above it, so words light up one by one in reading order.
  const words = document.querySelectorAll<HTMLElement>('[data-tagline] [data-word]');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (reducedMotion) {
    for (const word of words) word.setAttribute('data-active', '');
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const passed = entry.isIntersecting || entry.boundingClientRect.top < 0;
          entry.target.toggleAttribute('data-active', passed);
        }
      },
      { rootMargin: '0px 0px -40% 0px' },
    );
    for (const word of words) observer.observe(word);
  }
</script>
