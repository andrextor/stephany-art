---
// Page backdrop. `mesh` (gallery pages): a slow-drifting mesh gradient (clay, sage, sand) under a
// fine paper grain, fixed behind the page. `brushes` (about page): large faint brush strokes down
// the page, alternating sides; strokes past the end of a short page are clipped away.
// Wraps the page so its layers sit under the content, not the body.
import Brush from './Brush.astro';

interface Props {
  variant?: 'mesh' | 'brushes';
}

const { variant = 'mesh' } = Astro.props;

const strokes = [
  { top: '-4rem', side: 'right-0 translate-x-[30%] -rotate-12', color: 'text-clay/45', load: true },
  { top: '70rem', side: 'left-0 -translate-x-[35%] rotate-[14deg] -scale-x-100', color: 'text-sand/40' },
  { top: '130rem', side: 'right-0 translate-x-[35%] rotate-6', color: 'text-ink-faint/40' },
  { top: '190rem', side: 'left-0 -translate-x-[35%] -rotate-6 -scale-x-100', color: 'text-clay/40' },
];
---

<div class="relative isolate">
  {
    variant === 'mesh' ? (
      <div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden" aria-hidden="true">
        <div class="mesh-blob top-[-20%] right-[-15%] size-[70vmax] bg-clay/90" />
        <div class="mesh-blob bottom-[-25%] left-[-20%] size-[65vmax] bg-[#9fb3ae]/80 [animation-delay:-8s]" />
        <div class="mesh-blob top-[30%] left-[35%] size-[45vmax] bg-sand/70 [animation-delay:-16s]" />
        <div class="paper-grain absolute inset-0" />
      </div>
    ) : (
      <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
        {strokes.map((stroke, index) => (
          <div class:list={['absolute w-[min(120vw,860px)]', stroke.side]} style={`top: ${stroke.top}`}>
            <Brush
              seed={11 + index * 7}
              class:list={['block w-full', stroke.load ? 'brush--load' : 'brush--scroll', stroke.color]}
            />
          </div>
        ))}
      </div>
    )
  }
  <slot />
</div>
