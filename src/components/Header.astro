---
import { site, whatsappUrl } from '../data/site';
import { copy, langFromUrl, localePath, otherLangPath } from '../i18n';
import Icon from './Icon.astro';

const lang = langFromUrl(Astro.url);
const { ui, messages } = copy[lang];
const worksPath = localePath(lang, '/obras');
const links = [
  { href: localePath(lang, '/#world'), label: ui.tour },
  { href: worksPath, label: ui.works },
  { href: localePath(lang, '/sobre-mi'), label: ui.about },
  { href: '#contacto', label: ui.contact },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '');
const isCurrent = (href: string): boolean =>
  href === currentPath || (href === worksPath && currentPath.startsWith(worksPath));
const commissionHref = whatsappUrl(messages.commission);
---

<header class="pointer-events-none fixed inset-x-0 top-0 z-40 flex justify-center px-4 lg:justify-start lg:px-8 xl:px-16">
  <nav
    aria-label={ui.mainNav}
    style="view-transition-name: header"
    class="pointer-events-auto mt-6 flex w-max items-center gap-5 rounded-full border border-line bg-surface/75 py-2 pr-2 pl-6 shadow-sm backdrop-blur-xl"
  >
    <a href={localePath(lang, '/')} class="font-display text-xl text-ink">{site.artistName}</a>

    <div class="relative hidden md:block">
      <span aria-hidden="true" data-nav-indicator class="nav-indicator absolute top-0 left-0 h-9 rounded-full bg-ink/[0.07]"></span>
      <ul class="relative flex items-center">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                data-nav-link
                aria-current={isCurrent(link.href) ? 'page' : undefined}
                class="flex h-9 items-center rounded-full px-3 text-sm text-ink-soft transition-colors duration-700 ease-fluid hover:text-ink aria-[current]:text-ink"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <a
      href={commissionHref}
      target="_blank"
      rel="noopener"
      class="hidden items-center gap-2 rounded-full bg-clay px-4 py-2 text-sm font-semibold text-ink transition-transform duration-700 ease-fluid hover:-translate-y-0.5 active:translate-y-px md:inline-flex"
    >
      <Icon name="whatsapp" class="size-4" />
      {ui.commission}
    </a>

    <a
      href={otherLangPath(Astro.url)}
      data-lang-switch
      hreflang={lang === 'es' ? 'en' : 'es'}
      lang={lang === 'es' ? 'en' : 'es'}
      aria-label={ui.switchLabel}
      class="-ml-3 flex h-9 items-center rounded-full px-3 text-sm font-semibold text-ink-soft transition-colors duration-700 ease-fluid hover:text-ink"
    >
      {ui.switchShort}
    </a>

    <button
      type="button"
      data-menu-toggle
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label={ui.openMenu}
      data-label-open={ui.openMenu}
      data-label-close={ui.closeMenu}
      class="group relative size-10 rounded-full md:hidden"
    >
      <span
        class="absolute top-4 left-3 h-px w-4 bg-ink transition-transform duration-700 ease-fluid group-aria-expanded:translate-y-1 group-aria-expanded:rotate-45"
      ></span>
      <span
        class="absolute top-6 left-3 h-px w-4 bg-ink transition-transform duration-700 ease-fluid group-aria-expanded:-translate-y-1 group-aria-expanded:-rotate-45"
      ></span>
    </button>
  </nav>

  <div
    id="mobile-menu"
    data-menu
    class="group/menu pointer-events-auto invisible fixed inset-0 -z-10 flex flex-col justify-center gap-8 bg-bg/80 px-6 opacity-0 backdrop-blur-3xl transition-all duration-700 ease-fluid data-open:visible data-open:opacity-100 md:hidden"
  >
    <ul class="flex flex-col gap-6">
      {
        links.map((link, index) => (
          <li
            class="translate-y-12 opacity-0 transition-all duration-700 ease-fluid group-data-open/menu:translate-y-0 group-data-open/menu:opacity-100"
            style={`transition-delay: ${100 + index * 50}ms`}
          >
            <a href={link.href} data-menu-link class="font-display text-5xl text-ink">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a
      href={commissionHref}
      target="_blank"
      rel="noopener"
      class="inline-flex w-max items-center gap-2 rounded-full bg-ink px-3 py-2 text-base font-semibold text-bg"
    >
      <Icon name="whatsapp" class="size-5" />
      {ui.commission}
    </a>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  const setOpen = (open: boolean): void => {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? '');
    menu.toggleAttribute('data-open', open);
    document.documentElement.classList.toggle('overflow-hidden', open);
  };

  // Static build: carry the works filter over when switching language.
  const langSwitch = document.querySelector<HTMLAnchorElement>('[data-lang-switch]');
  if (langSwitch) langSwitch.search = window.location.search;

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  for (const link of document.querySelectorAll('[data-menu-link]')) {
    link.addEventListener('click', () => setOpen(false));
  }
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setOpen(false);
  });

  // A pill slides under the link of the section in view (home) or the current page.
  const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];
  const indicator = document.querySelector<HTMLElement>('[data-nav-indicator]');

  const moveIndicator = (): void => {
    if (!indicator) return;
    const active = navLinks.find((link) => link.hasAttribute('aria-current'));
    if (!active) {
      indicator.removeAttribute('data-visible');
      return;
    }
    indicator.toggleAttribute('data-instant', !indicator.hasAttribute('data-visible'));
    indicator.style.setProperty('--x', `${active.offsetLeft}px`);
    indicator.style.setProperty('--w', `${active.offsetWidth}px`);
    void indicator.offsetWidth;
    indicator.removeAttribute('data-instant');
    indicator.setAttribute('data-visible', '');
  };

  const setActive = (href: string | undefined): void => {
    for (const link of navLinks) {
      if (link.getAttribute('href') === href) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    }
    moveIndicator();
  };

  const spy = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) setActive((entry.target as HTMLElement).dataset.spy);
      }
    },
    { rootMargin: '-50% 0px -50% 0px' },
  );
  // The footer is shorter than half a screen, so it never crosses the middle line.
  const spyFooter = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) setActive((entry.target as HTMLElement).dataset.spy);
      }
    },
    { threshold: 0.5 },
  );
  for (const section of document.querySelectorAll<HTMLElement>('[data-spy]')) {
    (section.tagName === 'FOOTER' ? spyFooter : spy).observe(section);
  }
  const list = navLinks[0]?.closest('ul');
  if (list) new ResizeObserver(moveIndicator).observe(list);
</script>

<style>
  .nav-indicator {
    width: var(--w, 0);
    transform: translateX(var(--x, 0));
    opacity: 0;
    transition:
      transform 700ms var(--ease-fluid),
      width 700ms var(--ease-fluid),
      opacity 300ms var(--ease-fluid);
  }

  .nav-indicator[data-visible] {
    opacity: 1;
  }

  .nav-indicator[data-instant] {
    transition: none;
  }
</style>
