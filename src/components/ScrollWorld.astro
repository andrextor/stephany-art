---
import { site, whatsappUrl } from '../data/site';

const commission = { label: 'Encargar una obra', href: whatsappUrl(site.whatsapp.commissionMessage), external: true };

// Stops are still frames taken from the clips themselves (scripts/encode-world.mjs),
// and clip-N is the walk between stop N-1 and stop N. Phones get a portrait crop of
// each clip with the framing baked in, so there is no per-stop object-position.
const config = {
  nav: false,
  atmosphere: false,
  hint: 'Desliza para entrar',
  diveScroll: 0.9,
  connScroll: 1.4,
  crossfade: 0.12,
  sections: [
    {
      id: 'inicio',
      label: 'Inicio',
      still: '/world/stop-0.webp',
      stillMobile: '/world/stop-0-portrait.webp',
      scroll: 1.2,
      titleTag: 'h1',
      eyebrow: `${site.role} · ${site.country}`,
      title: site.artistName,
      body: 'Un viaje visual hacia los rincones del alma. Pinturas al óleo y acrílico donde la memoria cobra latido y el tiempo se detiene en el lienzo.',
      cta: { primary: commission, secondary: { label: 'Ver las obras', href: '/obras' } },
    },
    {
      id: 'taller',
      label: 'El taller',
      still: '/world/stop-1.webp',
      stillMobile: '/world/stop-1-portrait.webp',
      eyebrow: 'El taller',
      title: 'Donde nace cada obra',
      body: 'Donde el tiempo se desacelera entre pigmentos y bastidores. El taller es un refugio íntimo para dar forma a lo invisible.',
    },
    {
      id: 'comision',
      label: 'Por comisión',
      still: '/world/stop-2.webp',
      stillMobile: '/world/stop-2-portrait.webp',
      eyebrow: 'Obras por comisión',
      title: 'Tu historia, pintada a mano',
      body: 'Retratos, paisajes, animales y abstractos por encargo, con la misma atención al detalle que mi obra personal.',
      cta: { primary: commission, secondary: { label: 'Ver encargos', href: '/obras?cat=commission' } },
    },
    {
      id: 'personales',
      label: 'Personales',
      still: '/world/stop-3.webp',
      stillMobile: '/world/stop-3-portrait.webp',
      eyebrow: 'Obras personales',
      title: 'Entre la luz y la sombra',
      body: 'Obras sobre la memoria y la transformación humana, expuestas en la Bienal de Armenia en 2024 y 2026.',
      tags: ['La noche oscura del alma', 'Tránsito del alma'],
      cta: { secondary: { label: 'Ver obras personales', href: '/obras?cat=personal' } },
    },
    {
      id: 'en-proceso',
      label: 'En proceso',
      still: '/world/stop-4.webp',
      stillMobile: '/world/stop-4-portrait.webp',
      scroll: 1.4,
      eyebrow: 'En proceso',
      title: 'Capa a capa, en el caballete',
      body: 'Veladuras pacientes y texturas orgánicas: así avanza el retrato que estoy pintando ahora.',
      cta: { primary: commission, secondary: { label: 'Ver obras en proceso', href: '/obras?estado=in-progress' } },
    },
  ],
};

const configJson = JSON.stringify(config).replace(/</g, '\\u003c');

// Same height the engine gives its track (segments + 1vh of hand-off), reserved before
// the script runs so the page below does not flash and then jump.
const totalViewportHeights =
  config.sections.reduce((sum, section) => sum + (section.scroll ?? config.diveScroll), 0) +
  config.connScroll * (config.sections.length - 1) +
  1;
const firstStop = config.sections[0];
---

<div id="world" data-spy="/#world" aria-label="Recorrido por el taller" style={`--sw-total: ${totalViewportHeights}`}>
  <picture>
    <source media="(max-width: 860px)" srcset={firstStop.stillMobile} width="480" height="1040" />
    <img
      class="sw-poster"
      src={firstStop.still}
      srcset={`${firstStop.still} 1920w, ${firstStop.still.replace('.webp', '-1440.webp')} 2560w`}
      sizes="100vw"
      alt=""
      width="1920"
      height="1080"
      fetchpriority="high"
      decoding="async"
    />
  </picture>
  <div class="sw-prelude" aria-hidden="true">
    <article class="sw-copy">
      <span class="sw-copy__num">01 / {String(config.sections.length).padStart(2, '0')}</span>
      <span class="sw-copy__eyebrow">{firstStop.eyebrow}</span>
      <h1 class="sw-copy__title">{firstStop.title}</h1>
      <p class="sw-copy__body">{firstStop.body}</p>
      <div class="sw-copy__cta">
        <a class="sw-btn sw-btn--primary" href={firstStop.cta.primary.href} target="_blank" rel="noopener">
          {firstStop.cta.primary.label}
        </a>
        <a class="sw-btn sw-btn--ghost" href={firstStop.cta.secondary.href}>{firstStop.cta.secondary.label}</a>
      </div>
    </article>
  </div>
</div>
<script type="application/json" id="world-config" set:html={configJson} />

<script>
  import { mountScrollWorld } from '../scripts/scroll-world.js';

  const configElement = document.getElementById('world-config');
  const container = document.getElementById('world');

  if (configElement && container) {
    const config = JSON.parse(configElement.textContent ?? '{}');
    const clips = [1, 2, 3, 4];
    // Wide or hi-DPI desktops get the 2560x1440 tier; the rest the 1080 one (the phone
    // path ignores both and takes connectorsMobile).
    const wide = window.matchMedia('(min-width: 1800px), (min-width: 1200px) and (min-resolution: 1.5dppx)').matches;
    const tier = wide ? '1440' : '1080';
    const sections = wide
      ? config.sections.map((section: { still: string }) => ({ ...section, still: section.still.replace('.webp', '-1440.webp') }))
      : config.sections;

    mountScrollWorld(container, {
      ...config,
      sections,
      connectors: clips.map((n) => `/video/clip-${n}-${tier}.mp4`),
      connectorsMobile: clips.map((n) => `/video/clip-${n}-portrait.mp4`),
    });
    // The engine now renders the first stop's copy itself; drop the static prelude.
    container.querySelector('.sw-prelude')?.remove();
  }
</script>
