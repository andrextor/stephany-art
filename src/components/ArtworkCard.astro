---
import { Picture } from 'astro:assets';
import { type Artwork, categoryNames, mainImage, statusLabels } from '../lib/artworks';

interface Props {
  artwork: Artwork;
  eager?: boolean;
  headingLevel?: 2 | 3;
  sizes?: string;
  /** Entrance delay in ms, to stagger cards in a row. */
  delay?: number;
}

const {
  artwork,
  eager = false,
  headingLevel = 3,
  sizes = '(min-width: 1152px) 352px, (min-width: 1024px) 30vw, (min-width: 640px) 45vw, 90vw',
  delay = 0,
} = Astro.props;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
const { title, category, status, year } = artwork.data;
const image = mainImage(artwork);
---

<a
  href={`/obras/${artwork.id}`}
  data-category={category}
  data-status={status ?? 'none'}
  data-reveal
  style={`--d: ${delay}ms`}
  class="group flex flex-col gap-4"
>
  <div style={`view-transition-name: obra-${artwork.id}`}>
    <Picture
      src={image.src}
      alt={image.alt}
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      widths={[400, 640, 960]}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      class="canvas w-full transition-transform duration-700 ease-fluid group-hover:-translate-y-1"
    />
  </div>
  <div class="flex flex-col gap-0.5">
    <Heading class="text-2xl text-ink italic">{title}</Heading>
    <p class="text-sm text-ink-soft">
      {categoryNames[category]}
      {status && <span class="font-semibold text-moss-deep"> · {statusLabels[status]}</span>}
      {!status && year && <span> · {year}</span>}
    </p>
  </div>
</a>
